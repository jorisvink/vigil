diff -ru a/src/kyrka.c b/src/kyrka.c
--- a/src/kyrka.c	2026-11-18 12:13:30.074901961 +0100
+++ b/src/kyrka.c	2026-11-18 12:13:30.088902111 +0100
@@ -175,6 +175,29 @@
 }
 
 /*
+ * Load 256-bit of additional input that is mixed into every base key we
+ * derive for our peer, both sides must load the same input.
+ */
+int
+kyrka_additional_kdf_input(KYRKA *ctx, const void *ikm, size_t ikm_len)
+{
+	if (ctx == NULL)
+		return (-1);
+
+	if (ikm == NULL || ikm_len != KYRKA_ADDITIONAL_INPUT_LENGTH) {
+		ctx->last_error = KYRKA_ERROR_PARAMETER;
+		return (-1);
+	}
+
+	nyfe_memcpy(ctx->cfg.input, ikm, ikm_len);
+	kyrka_mask(ctx, ctx->cfg.input, sizeof(ctx->cfg.input));
+
+	ctx->flags |= KYRKA_FLAG_ADDITIONAL_INPUT;
+
+	return (0);
+}
+
+/*
  * Sets the cathedral secret directly by copying in the given secret.
  *
  * Only call this if you did not specify the secret in the kyrka_cathedral_cfg
