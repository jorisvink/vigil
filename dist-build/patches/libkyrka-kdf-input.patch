 static void
+exchange_input(struct peer *peer, u_int8_t fill)
+{
+	u_int8_t	ikm[KYRKA_ADDITIONAL_INPUT_LENGTH];
+
+	memset(ikm, fill, sizeof(ikm));
+	VERIFY(kyrka_additional_kdf_input(peer->ctx, ikm, sizeof(ikm)) == 0);
+}
+
+static void
+key_exchange_additional_input(u_int8_t fill_a, u_int8_t fill_b, int flows)
+{
+	int		idx;
+
+	exchange_setup();
+
+	if (fill_a != 0)
+		exchange_input(&peer_a, fill_a);
+
+	if (fill_b != 0)
+		exchange_input(&peer_b, fill_b);
+
+	for (idx = 0; idx < 30; idx++)
+		exchange_pulse(0, 0);
+
+	if (flows) {
+		VERIFY(exchange_traffic_flows());
+		VERIFY(peer_a.ctx->tx.spi == peer_b.ctx->rx.spi);
+		VERIFY(peer_a.ctx->rx.spi == peer_b.ctx->tx.spi);
+	} else {
+		VERIFY(!exchange_traffic_flows());
+		VERIFY(peer_a.ctx->tx.cipher == NULL);
+		VERIFY(peer_b.ctx->tx.cipher == NULL);
+	}
+
+	exchange_cleanup();
+}
+
+static void
+key_exchange_additional_input_same_test(void)
+{
+	key_exchange_additional_input(0x11, 0x11, 1);
+}
+
+static void
+key_exchange_additional_input_differs_test(void)
+{
+	key_exchange_additional_input(0x11, 0x22, 0);
+}
+
+static void
+key_exchange_additional_input_one_side_test(void)
+{
+	key_exchange_additional_input(0x11, 0, 0);
+	key_exchange_additional_input(0, 0x11, 0);
+}
+
+static void
+key_exchange_additional_input_none_test(void)
+{
+	key_exchange_additional_input(0, 0, 1);
+}
+
+static void
 key_exchange_peer_restart_test(void)
